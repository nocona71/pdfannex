\tl_set:Nn \l__pdfannex_annexname_tl { Annex }
\tl_set:Nn \l__pdfannex_heading_tl { Annexes }

\keys_define:nn { pdfannex }
  {
    annex-name .tl_set:N = \l__pdfannex_annexname_tl ,
    heading    .tl_set:N = \l__pdfannex_heading_tl ,
    layout     .tl_set:N = \l__pdfannex_layout_tl ,
    page-style .tl_set:N = \l__pdfannex_pagestyle_tl ,
    pagination .tl_set:N = \l__pdfannex_pagination_tl ,
    label      .tl_set:N = \l__pdfannex_label_tl ,
    pages      .tl_set:N = \l__pdfannex_pages_tl ,
    nup        .tl_set:N = \l__pdfannex_nup_tl ,
    margin       .dim_set:N = \l__pdfannex_margin_dim ,
    footer-space .dim_set:N = \l__pdfannex_footer_dim ,
    bookmark   .bool_set:N = \l__pdfannex_bookmark_bool ,
    list       .bool_set:N = \l__pdfannex_list_bool ,
    frame      .bool_set:N = \l__pdfannex_frame_bool ,
    frame      .default:n = true ,
    bookmark   .default:n = true ,
    list       .default:n = true ,
  }

% Physical pages shipped so far; lets pagination=continue survive classes
% (e.g. scrlttr2) that reset the page counter.
\int_new:N \g__pdfannex_shipped_int
\AddToHook { shipout / before } { \int_gincr:N \g__pdfannex_shipped_int }

\NewDocumentCommand \pdfannexsetup { m }
  { \keys_set:nn { pdfannex } { #1 } }

\pdfannexsetup { layout = fullpage, page-style = plain, pagination = inherit }

\NewDocumentCommand \includeannex { O{} m m }
  {
    \group_begin:
      \tl_clear:N \l__pdfannex_label_tl
      \tl_set:Nn \l__pdfannex_pages_tl { - }
      \tl_clear:N \l__pdfannex_nup_tl
      \bool_set_false:N \l__pdfannex_frame_bool
      \dim_zero:N \l__pdfannex_margin_dim
      \dim_zero:N \l__pdfannex_footer_dim
      \bool_set_true:N \l__pdfannex_bookmark_bool
      \bool_set_true:N \l__pdfannex_list_bool
      \keys_set:nn { pdfannex } { #1 }
      \tl_set:Nn \l__pdfannex_title_tl { #3 }
      \__pdfannex_resolve:n { #2 }
      \bool_if:NT \l__pdfannex_found_bool
        {
          \file_if_exist:VF \l__pdfannex_file_tl
            { \msg_error:nnV { pdfannex } { file-not-found } \l__pdfannex_file_tl }
        }
      \stepcounter { annex }
      \str_if_eq:VnT \l__pdfannex_pagination_tl { continue }
        {
          \clearpage
          \int_set:Nn \c@page { \g__pdfannex_shipped_int + 1 }
        }
      \bool_if:NT \l__pdfannex_found_bool
        {
          \bool_gset_true:N \g__pdfannex_first_bool
          \exp_args:NV \__pdfannex_include:n \l__pdfannex_file_tl
        }
    \group_end:
  }

% \NewAnnexSource{\includefoo}{foo} defines \includefoo[opts]{ref}{title} as
% \includeannex[opts]{pdfannex://foo/ref}{title}. The scheme is any name; the
% CLI looks for the matching resolver, TeX never needs to know it.
\NewDocumentCommand \NewAnnexSource { m m }
  {
    \NewDocumentCommand #1 { O{} m m }
      { \includeannex [ ##1 ] { pdfannex:// #2 / ##2 } { ##3 } }
  }

% Source handling. Plain paths mean pdfannex://file/<path>. The source is
% recorded for the optional CLI; if the CLI locked it, the stored artifact in
% the resolution map is used instead of the original path.
\cs_generate_variant:Nn \file_if_exist:nF { V }
\cs_generate_variant:Nn \msg_error:nnn { nnV }
\cs_new_protected:Npn \__pdfannex_strip_dot_slash:
  {
    \str_if_eq:eeT { \str_range:Nnn \l__pdfannex_key_str { 1 } { 2 } } { ./ }
      {
        \str_set:Nx \l__pdfannex_key_str { \str_range:Nnn \l__pdfannex_key_str { 3 } { -1 } }
        \__pdfannex_strip_dot_slash:
      }
  }
% The key is the source as written, without leading ./ . It is exchanged with
% the CLI hex-encoded (UTF-8 bytes), so any file name is safe in the generated
% files; the CLI decodes it.
\cs_new_protected:Npn \__pdfannex_make_key:
  {
    \str_set:Nx \l__pdfannex_key_str { \tl_to_str:N \l__pdfannex_file_tl }
    \__pdfannex_strip_dot_slash:
    \sys_if_engine_pdftex:TF
      { \exp_args:NNV \str_set_convert:Nnnn \l__pdfannex_hex_str \l__pdfannex_key_str { utf8 } { utf8/hex } }
      { \exp_args:NNV \str_set_convert:Nnnn \l__pdfannex_hex_str \l__pdfannex_key_str { } { utf8/hex } }
  }
% Opt-in: requests are recorded only in projects that use the CLI, i.e. when
% pdfannex.lock exists (created by `pdfannex init`).
\cs_new_protected:Npn \__pdfannex_write_request:
  {
    \file_if_exist:nT { pdfannex.lock }
      {
        \bool_if:NF \g__pdfannex_requests_open_bool
          {
            \iow_open:Nn \g__pdfannex_requests_iow { \c_sys_jobname_str .pdfannex-requests }
            \bool_gset_true:N \g__pdfannex_requests_open_bool
          }
        \iow_now:Nx \g__pdfannex_requests_iow { \l__pdfannex_hex_str }
      }
  }
\cs_new_protected:Npn \__pdfannex_resolve:n #1
  {
    \group_begin:
      \cs_set_eq:NN \% \c_percent_str
      \cs_set_eq:NN \# \c_hash_str
      \cs_set_eq:NN \& \c_ampersand_str
      \cs_set_eq:NN \_ \c_underscore_str
      \tl_gset:Nx \g__pdfannex_tmp_tl { #1 }
    \group_end:
    \tl_set_eq:NN \l__pdfannex_file_tl \g__pdfannex_tmp_tl
    \__pdfannex_make_key:
    \__pdfannex_write_request:
    \bool_set_true:N \l__pdfannex_found_bool
    \cs_if_exist:cTF { __pdfannex_res_ \l__pdfannex_hex_str }
      {
        % Rescan: pdfpages on XeTeX fails to count pages for a path of catcode-12 letters.
        \tl_set_rescan:Nnx \l__pdfannex_file_tl { }
          { \use:c { __pdfannex_res_ \l__pdfannex_hex_str } }
      }
      {
        \str_if_eq:eeT { \str_range:Nnn \l__pdfannex_key_str { 1 } { 11 } } { pdfannex:// }
          {
            \bool_set_false:N \l__pdfannex_found_bool
            \msg_error:nnV { pdfannex } { unresolved-source } \l__pdfannex_key_str
          }
      }
  }
\NewDocumentCommand \PdfAnnexProvideResolvedArtifact { m m }
  { \cs_gset:cpx { __pdfannex_res_ \tl_to_str:n {#1} } { \tl_to_str:n {#2} } }
\AtBeginDocument
  {
    \file_if_exist:nT { .pdfannex/resolved.tex }
      { \file_input:n { .pdfannex/resolved.tex } }
  }

\cs_new_protected:Npn \__pdfannex_include:n #1
  {
    \exp_args:Nx \__pdfannex_includepdf:nn
      {
        \__pdfannex_layout_opts: ,
        pages = \l__pdfannex_pages_tl ,
        \tl_if_empty:NF \l__pdfannex_nup_tl { nup = \l__pdfannex_nup_tl , }
        pagecommand = { \exp_not:N \__pdfannex_page_hook: } ,
      }
      { #1 }
  }
\cs_new_protected:Npn \__pdfannex_includepdf:nn #1#2
  { \includepdf [ #1 ] { #2 } }

% Layout -> pdfpages options. The host sheet size is kept (no fitpaper):
% pdfpages shrinks oversized source pages to fit, never enlarges, keeps the
% aspect ratio and does not rotate; scale shrinks further.
\cs_new:Npn \__pdfannex_layout_opts:
  {
    \bool_if:NT \l__pdfannex_frame_bool { frame = true , }
    \bool_lazy_and:nnTF
      { \dim_compare_p:nNn { \l__pdfannex_margin_dim } = { \c_zero_dim } }
      { \dim_compare_p:nNn { \l__pdfannex_footer_dim } = { \c_zero_dim } }
      { \__pdfannex_layout_preset: }
      { \__pdfannex_layout_custom: }
  }
% margin/footer-space are relative to the host paper size and applied as a
% uniform scale; the footer area is cleared by shifting the content up.
\cs_new:Npn \__pdfannex_layout_custom:
  {
    scale =
      \fp_eval:n
        {
          min
            (
              \dim_ratio:nn { \paperwidth - 2 \l__pdfannex_margin_dim } { \paperwidth } ,
              \dim_ratio:nn
                { \paperheight - 2 \l__pdfannex_margin_dim - \l__pdfannex_footer_dim }
                { \paperheight }
            )
        } ,
    offset = 0pt~ \dim_eval:n { \l__pdfannex_footer_dim / 2 }
  }
\cs_new:Npn \__pdfannex_layout_preset:
  {
    \str_case:VnF \l__pdfannex_layout_tl
      {
        { fullpage } { }
        { footer-safe } { scale = 0.9 , offset = 0mm~5mm }
        { framed } { scale = 0.85 , frame = true }
      }
      { }
  }

% pdfpages has no first-page-only pagecommand (only picturecommand*, which runs
% at shipout), so run first-page work once per annex via a global flag.
\cs_new_protected:Npn \__pdfannex_page_hook:
  {
    \thispagestyle { \l__pdfannex_pagestyle_tl }
    \bool_if:NT \g__pdfannex_first_bool
      {
        \bool_gset_false:N \g__pdfannex_first_bool
        \__pdfannex_first_page:
      }
  }
\cs_new_protected:Npn \__pdfannex_first_page:
  {
    \hypertarget { pdfannex.\theannex } { }
    \tl_if_empty:NF \l__pdfannex_label_tl
      {
        \protected@write \@auxout { }
          {
            \string \pdfannex@newlabel
              { \l__pdfannex_label_tl } { \theannex } { \thepage }
          }
      }
    \bool_if:NT \l__pdfannex_list_bool
      {
        \protected@write \@auxout { }
          {
            \string \pdfannex@loa
              { \theannex } { \l__pdfannex_title_tl } { \thepage }
          }
      }
    \bool_if:NT \l__pdfannex_bookmark_bool
      {
        \bookmark
          [ level = 1 , dest = pdfannex.\theannex ]
          { \l__pdfannex_annexname_tl \c_space_tl \theannex :~\l__pdfannex_title_tl }
      }
  }

\cs_new_protected:cpn { pdfannex@newlabel } #1#2#3
  {
    \cs_gset:cpn { __pdfannex_ref_#1 } { {#2} {#3} }
  }
% Read side: .aux is processed with @ and _ as letters via \@input.
\cs_new_protected:cpn { pdfannex@loa } #1#2#3
  {
    \tl_gput_right:Nn \g__pdfannex_loa_tl
      { \__pdfannex_loa_line:nnn {#1} {#2} {#3} }
  }
\tl_new:N \g__pdfannex_loa_tl
\cs_new_protected:Npn \__pdfannex_loa_line:nnn #1#2#3
  {
    \par\noindent
    \hyperlink { pdfannex.#1 } { \l__pdfannex_annexname_tl \c_space_tl #1 :~#2 }
    \dotfill~#3 \par
  }
\NewDocumentCommand \listofannexes { }
  {
    \section* { \l__pdfannex_heading_tl }
    \g__pdfannex_loa_tl
  }

\cs_new:Npn \__pdfannex_ref_num:n #1
  {
    \cs_if_exist:cTF { __pdfannex_ref_#1 }
      { \exp_last_unbraced:Nf \use_i:nn { \use:c { __pdfannex_ref_#1 } } }
      { ?? }
  }
\cs_new:Npn \__pdfannex_ref_page:n #1
  {
    \cs_if_exist:cTF { __pdfannex_ref_#1 }
      { \exp_last_unbraced:Nf \use_ii:nn { \use:c { __pdfannex_ref_#1 } } }
      { ?? }
  }

\NewDocumentCommand \annexref { m }
  {
    \hyperlink { pdfannex. \__pdfannex_ref_num:n {#1} }
      { \l__pdfannex_annexname_tl \c_space_tl \__pdfannex_ref_num:n {#1} }
  }
\NewDocumentCommand \annexpageref { m } { \__pdfannex_ref_page:n {#1} }

\msg_new:nnn { pdfannex } { file-not-found } { File~'#1'~not~found. }
\msg_new:nnnn { pdfannex } { unresolved-source }
  { Source~'#1'~is~not~resolved. }
  { Run~'pdfannex~prepare~\c_sys_jobname_str.tex'~and~then~LaTeX~again. }

\ExplSyntaxOff

