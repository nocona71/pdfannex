#!/usr/bin/env bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
stage="$(mktemp -d)"
trap 'rm -rf -- "$stage"' EXIT

mkdir -p "$stage/ctan"
cp "$root/build.lua" \
  "$root/pdfannex-docstore.sty" \
  "$root/pdfannex-resolver-docstore" \
  "$root/adapter-lib.lua" \
  "$stage/"
cp "$root/ctan/LICENSE" \
  "$root/ctan/README.md" \
  "$root/ctan/pdfannex-docstore-doc.tex" \
  "$root/ctan/pdfannex-resolver-docstore.1" \
  "$stage/ctan/"

(
  cd "$stage"
  l3build ctan
)

cp "$stage/pdfannex-docstore-ctan.zip" "$root/"
mkdir -p "$root/build/distrib/tds"
cp "$stage/build/distrib/tds/pdfannex-docstore.tds.zip" \
  "$root/build/distrib/tds/"
