#!/usr/bin/env texlua
-- Example Resolver Protocol 1 resolver and fork-start for community adapters.
--
-- Serves pdfannex://docstore/<id>[?rev=<n>] from an HTTP document service
-- (see docstore_server.py for the API). Without rev the latest revision is
-- chosen and pinned in the resolved locator, which is what the lock records.
--
-- Configuration comes from the environment, never from the document or the lock:
--   PDFANNEX_DOCSTORE_URL    base URL of the service (required)
--   PDFANNEX_DOCSTORE_TOKEN  bearer token (optional)
--   PDFANNEX_DOCSTORE_TIMEOUT  seconds per request (optional, default 30)
--
-- To write your own adapter, replace `parse_source`, `fetch` and the use of the
-- service API in `remote`; everything else is protocol plumbing. Hashing and
-- storage belong to the pdfannex CLI.
local script_dir = (arg[0] or ""):match("^(.*)/[^/]*$") or "."
package.path = script_dir .. "/?.lua;" .. package.path
local lib = require("adapter-lib")

local VERSION = "0.2.0"
local SCHEME = "docstore"
local TIMEOUT = (os.getenv("PDFANNEX_DOCSTORE_TIMEOUT") or ""):match("^%d+$") or "30" -- seconds per request
local MAX_BYTES = "104857600" -- 100 MB per PDF

local function reply(obj) io.stdout:write(lib.json_encode(obj), "\n") end
local function fail(id, code, message) return { id = id, error = { code = code, message = message } } end
local function quote(s) return "'" .. s:gsub("'", "'\\''") .. "'" end

-- Map an HTTP status to a protocol error code.
local function status_error(status)
  if status == 401 then return "authentication-required", "the service rejected the credentials" end
  if status == 403 then return "permission-denied", "access denied" end
  if status == 404 then return "resource-not-found", "not found" end
  return "temporarily-unavailable", "unexpected HTTP status " .. tostring(status)
end

-- GET <base>/<path> with curl. The token goes through a private temporary curl
-- config, so it never appears in the process list. Returns the response body
-- (a string, or the downloaded file name when `to_file` is set), or
-- nil, code, message.
local function fetch(path, to_file)
  local base = os.getenv("PDFANNEX_DOCSTORE_URL")
  if not base or base == "" then
    return nil, "temporarily-unavailable", "PDFANNEX_DOCSTORE_URL is not set"
  end
  local cfg, out, err = os.tmpname(), os.tmpname(), os.tmpname()
  local function cleanup(keep_out)
    os.remove(cfg); os.remove(err)
    if not keep_out then os.remove(out) end
  end
  local token = os.getenv("PDFANNEX_DOCSTORE_TOKEN")
  if token and token ~= "" then
    if token:find('[%c"\\]') then
      cleanup()
      return nil, "authentication-required", "PDFANNEX_DOCSTORE_TOKEN contains unsupported characters"
    end
    lib.write_file(cfg, 'header = "Authorization: Bearer ' .. token .. '"\n')
  end
  -- No redirects are followed and only http(s) is allowed.
  local cmd = table.concat({ "curl -sS --proto '=http,https' --max-time", TIMEOUT,
    "--max-filesize", MAX_BYTES, "-K", quote(cfg), "-o", quote(out),
    "-w '%{http_code}'", quote(base:gsub("/+$", "") .. path), "2>", quote(err) }, " ")
  local pipe = io.popen(cmd, "r")
  local status = tonumber(pipe:read("a")) or 0
  local ok = pipe:close()
  if not ok then
    local detail = (lib.read_file(err) or ""):gsub("%s+$", "")
    cleanup()
    return nil, "temporarily-unavailable", "service not reachable: " .. detail
  end
  if status ~= 200 then
    cleanup()
    return nil, status_error(status)
  end
  local body = to_file and out or lib.read_file(out)
  cleanup(to_file)
  return body
end

-- Pure parsing of the source URI: returns { id, rev } (rev may be nil) or
-- nil, code, message.
local function parse_source(source)
  local id, query = source:match("^pdfannex://" .. SCHEME .. "/([^?]*)%??(.*)$")
  if not id or #id > 64 or not id:match("^[%w_%-]+$") then
    return nil, "invalid-source", "expected pdfannex://" .. SCHEME .. "/<id>"
  end
  local rev
  for key, value in query:gmatch("([^&=]+)=?([^&]*)") do
    if key ~= "rev" or rev or not value:match("^[1-9]%d?%d?%d?%d?%d?%d?%d?%d?$") then
      return nil, "unsupported-source-option", "unsupported or repeated option: " .. key .. "=" .. value
    end
    rev = value
  end
  return { id = id, rev = rev }
end

-- Service API: the latest revision number of a document.
local function remote_latest(id)
  local body, code, message = fetch("/docs/" .. id)
  if not body then return nil, code, message end
  local ok, meta = pcall(lib.json_decode, body)
  local latest = ok and type(meta) == "table" and meta.latest
  if math.type(latest) ~= "integer" or latest < 1 then
    return nil, "temporarily-unavailable", "the service returned an invalid document description"
  end
  return tostring(latest)
end

-- Service API: download one revision to a temporary file. Content that does
-- not look like a PDF is refused. Returns the file name or nil, code, message.
local function remote_revision(id, rev)
  local file, code, message = fetch("/docs/" .. id .. "/" .. rev .. ".pdf", true)
  if not file then return nil, code, message end
  local f = io.open(file, "rb")
  local head = f and f:read(5)
  if f then f:close() end
  if head ~= "%PDF-" then
    os.remove(file)
    return nil, "resource-not-found", "revision " .. rev .. " of " .. id .. " is not a PDF"
  end
  return file
end

local function resolve_one(req)
  local src, code, message = parse_source(req.source or "")
  if not src then return fail(req.id, code, message) end
  local rev = src.rev
  if not rev then
    rev, code, message = remote_latest(src.id)
    if not rev then return fail(req.id, code, message) end
  end
  local file
  file, code, message = remote_revision(src.id, rev)
  if not file then return fail(req.id, code, message) end
  return { id = req.id, resolved = "pdfannex://" .. SCHEME .. "/" .. src.id .. "?rev=" .. rev,
           artifact = { path = file } }
end

-- The locked revision is the one in req.resolved. It must still exist, and its
-- bytes must still match the lock; otherwise it was changed on the server. A
-- newer revision means update-available (unless the source pins a revision).
local function status_one(req)
  local src, code, message = parse_source(req.source or "")
  if not src then return fail(req.id, code, message) end
  local locked = (req.resolved or ""):match("^pdfannex://" .. SCHEME .. "/[%w_%-]+%?rev=([1-9]%d*)$")
  local latest
  latest, code, message = remote_latest(src.id)
  if not latest then return fail(req.id, code, message) end
  if not locked then return { id = req.id, state = "unknown" } end
  local file
  file, code, message = remote_revision(src.id, locked)
  if not file then return fail(req.id, code, message) end
  local data = lib.read_file(file)
  os.remove(file)
  if req.lockedSha256 and lib.sha256_hex(data or "") ~= req.lockedSha256 then
    return { id = req.id, state = "update-available" }
  end
  local newer = not src.rev and tonumber(locked) < tonumber(latest)
  return { id = req.id, state = newer and "update-available" or "up-to-date" }
end

local ok, request = pcall(lib.json_decode, io.stdin:read("a"))
if not ok or type(request) ~= "table" then
  io.stderr:write("pdfannex-resolver-" .. SCHEME .. ": malformed request\n")
  reply({ error = { code = "malformed-request", message = "stdin is not a JSON object" } })
  os.exit(1)
end

local op = request.operation
if op == "describe" then
  reply({ resolver = { name = SCHEME, version = VERSION }, protocolVersions = { 1 },
          schemes = { SCHEME }, capabilities = { "resolve", "status" } })
elseif op == "resolve" or op == "status" then
  if request.protocolVersion ~= 1 then
    reply({ error = { code = "unsupported-protocol", message = "only protocol version 1 is supported" } })
    os.exit(1)
  end
  if type(request.requests) ~= "table" then
    reply({ error = { code = "invalid-request", message = "requests must be an array" } })
    os.exit(1)
  end
  local results = {}
  for i, req in ipairs(request.requests) do
    results[i] = (op == "resolve" and resolve_one or status_one)(req)
  end
  reply({ protocolVersion = 1, results = results })
else
  reply({ error = { code = "invalid-request", message = "unknown operation: " .. tostring(op) } })
  os.exit(1)
end
