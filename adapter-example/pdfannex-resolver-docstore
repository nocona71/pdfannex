#!/usr/bin/env texlua
-- Example Resolver Protocol 1 resolver and fork-start for community adapters.
--
-- Serves pdfannex://docstore/<id>[?rev=<n>] from $PDFANNEX_DOCSTORE_DIR
-- (default ./docstore) laid out as <dir>/<id>/<n>.pdf. Without rev the latest
-- revision is chosen and pinned in the resolved locator, which is what the lock
-- records. To write your own adapter, replace the body of `lookup`; everything
-- else is protocol plumbing. Hashing and storage belong to the CLI.
local script_dir = (arg[0] or ""):match("^(.*)/[^/]*$") or "."
package.path = script_dir .. "/?.lua;" .. package.path
local lib = require("adapter-lib")

local VERSION = "0.1.0"
local SCHEME = "docstore"

local function reply(obj) io.stdout:write(lib.json_encode(obj), "\n") end
local function fail(id, code, message) return { id = id, error = { code = code, message = message } } end

-- Revision files are canonical decimal numbers: 1.pdf, 2.pdf, ... (no leading zeros).
local function latest_revision(dir)
  local best
  for name in lfs.dir(dir) do
    local n = name:match("^([1-9]%d*)%.pdf$")
    if n and #n <= 9 and (not best or tonumber(n) > tonumber(best)) then best = n end
  end
  return best
end

-- A revision must be a regular file (no symlinks, so the store cannot point
-- outside itself) that starts like a PDF. The CLI hashes and locks the bytes.
local function check_revision(path)
  if lfs.symlinkattributes(path, "mode") ~= "file" then
    return nil, "resource-not-found", "revision is missing or not a regular file"
  end
  local f = io.open(path, "rb")
  if not f then return nil, "permission-denied", "cannot read revision" end
  local head = f:read(5)
  f:close()
  if head ~= "%PDF-" then return nil, "resource-not-found", "revision is not a PDF" end
  return true
end

-- Adapter-specific part. Returns { path, rev, id, latest } or nil, code, message.
local function lookup(source)
  local id, query = source:match("^pdfannex://" .. SCHEME .. "/([^?]*)%??(.*)$")
  if not id or not id:match("^[%w_%-]+$") then
    return nil, "invalid-source", "expected pdfannex://" .. SCHEME .. "/<id>"
  end
  local rev
  for key, value in query:gmatch("([^&=]+)=?([^&]*)") do
    if key ~= "rev" or rev or not value:match("^[1-9]%d?%d?%d?%d?%d?%d?%d?%d?$") then
      return nil, "unsupported-source-option", "unsupported or repeated option: " .. key .. "=" .. value
    end
    rev = value
  end
  local root = os.getenv("PDFANNEX_DOCSTORE_DIR") or "docstore"
  local dir = root .. "/" .. id
  if lfs.symlinkattributes(dir, "mode") ~= "directory" then
    return nil, "resource-not-found", "no document " .. id
  end
  local latest = latest_revision(dir)
  rev = rev or latest
  if not rev then return nil, "resource-not-found", "document " .. id .. " has no revisions" end
  local path = dir .. "/" .. rev .. ".pdf"
  local ok, code, message = check_revision(path)
  if not ok then return nil, code, "revision " .. rev .. " of " .. id .. ": " .. message end
  if path:sub(1, 1) ~= "/" then path = lfs.currentdir() .. "/" .. path end
  return { path = path, rev = rev, id = id, latest = latest }
end

local function resolve_one(req)
  local doc, code, message = lookup(req.source or "")
  if not doc then return fail(req.id, code, message) end
  return { id = req.id, resolved = "pdfannex://" .. SCHEME .. "/" .. doc.id .. "?rev=" .. doc.rev,
           artifact = { path = doc.path } }
end

-- The locked revision is the one in req.resolved. It must still exist, and its
-- bytes must still match the lock; otherwise the store was changed in place.
-- A newer revision means update-available.
local function status_one(req)
  local locked = (req.resolved or ""):match("^pdfannex://" .. SCHEME .. "/[%w_%-]+%?rev=([1-9]%d*)$")
  if not locked then
    local _, code, message = lookup(req.source or "")
    if code then return fail(req.id, code, message) end
    return { id = req.id, state = "unknown" }
  end
  local doc, code, message = lookup((req.resolved:gsub("^(.-)%?rev=.*$", "%1")) .. "?rev=" .. locked)
  if not doc then return fail(req.id, code, message) end
  if req.lockedSha256 then
    local data = lib.read_file(doc.path)
    if not data or lib.sha256_hex(data) ~= req.lockedSha256 then
      return { id = req.id, state = "update-available" }
    end
  end
  -- A source that pins ?rev= never has a newer revision to offer.
  local pinned = (req.source or ""):find("[?&]rev=")
  return { id = req.id, state = (not pinned and tonumber(locked) < tonumber(doc.latest)) and "update-available" or "up-to-date" }
end

local ok, request = pcall(lib.json_decode, io.stdin:read("a"))
if not ok or type(request) ~= "table" then
  io.stderr:write("pdfannex-resolver-" .. SCHEME .. ": malformed request\n")
  reply({ error = { code = "malformed-request", message = "stdin is not a JSON object" } })
  os.exit(1)
end

local op = request.operation
if op == "describe" then
  reply({ resolver = { name = SCHEME, version = VERSION }, protocolVersions = { 1 },
          schemes = { SCHEME }, capabilities = { "resolve", "status" } })
elseif op == "resolve" or op == "status" then
  if request.protocolVersion ~= 1 then
    reply({ error = { code = "unsupported-protocol", message = "only protocol version 1 is supported" } })
    os.exit(1)
  end
  if type(request.requests) ~= "table" then
    reply({ error = { code = "invalid-request", message = "requests must be an array" } })
    os.exit(1)
  end
  local results = {}
  for i, req in ipairs(request.requests) do
    results[i] = (op == "resolve" and resolve_one or status_one)(req)
  end
  reply({ protocolVersion = 1, results = results })
else
  reply({ error = { code = "invalid-request", message = "unknown operation: " .. tostring(op) } })
  os.exit(1)
end
