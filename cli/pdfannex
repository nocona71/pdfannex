#!/usr/bin/env texlua
-- pdfannex CLI: external-source preparation and reproducibility (spec/09, spec/10).
-- Owns hashing, the project-local artifact store, pdfannex.lock and the
-- resolution map. Resolvers (Resolver Protocol 1) only acquire PDFs.
local script_path = ((arg[0] or ""):gsub("\\", "/"))
local script_dir = script_path:match("^(.*)/[^/]*$") or "."
if script_dir:sub(1, 1) ~= "/" and not script_dir:match("^%a:/") then
  script_dir = lfs.currentdir() .. "/" .. script_dir
end
local support = script_dir
local file = io.open(support .. "/pdfannex-lib.lua", "r")
if file then
  file:close()
else
  kpse.set_program_name("latex")
  local found = kpse.find_file("pdfannex-lib.lua", "texmfscripts")
  if found then support = found:gsub("\\", "/"):match("^(.*)/[^/]+$") or support end
end
package.path = support .. "/?.lua;" .. package.path
local lib = require("pdfannex-lib")

local VERSION = "0.1.0"
local LOCK = "pdfannex.lock"
local STORE = ".pdfannex/objects/sha256"
local MAP = ".pdfannex/resolved.tex"

local function die(msg)
  io.stderr:write("pdfannex: ", msg, "\n")
  os.exit(1)
end

local USAGE = [[
usage: pdfannex <command> document.tex

commands:
  init      start using the CLI in this directory: create an empty pdfannex.lock,
            which makes pdfannex.sty record requests (usage: pdfannex init)
  prepare   lock requested sources that are not locked yet (no resolver calls
            when everything is locked); regenerate the resolution map
  update    explicitly re-resolve all requested sources and advance the lock
  status    report whether locked sources changed upstream (read-only)
  verify    check lock, artifact store and resolution map locally]]

---------------------------------------------------------------- project state
-- Returns a list of { raw = <source as written>, uri = <normalized source> }.
local function load_requests(jobname)
  local text = lib.read_file(jobname .. ".pdfannex-requests")
  if not text then return nil end
  local seen, list = {}, {}
  for line in text:gmatch("[^\r\n]+") do
    local raw = lib.hex_decode(line)
    if not raw then die(jobname .. ".pdfannex-requests: invalid entry '" .. line .. "'") end
    if not seen[raw] then
      seen[raw] = true
      list[#list + 1] = { raw = raw, uri = lib.normalize_source(raw) }
    end
  end
  return list
end

local function load_lock()
  local text = lib.read_file(LOCK)
  if not text then return { schema = 1, sources = {} } end
  local ok, lock = pcall(lib.json_decode, text)
  if not ok or type(lock) ~= "table" then die(LOCK .. " is not valid JSON") end
  if lock.schema ~= 1 then die(LOCK .. ": unsupported lock schema " .. tostring(lock.schema)) end
  lock.sources = lock.sources or {}
  return lock
end

local function object_path(sha)
  return STORE .. "/" .. sha:sub(1, 2) .. "/" .. sha .. ".pdf"
end

-- Map from the source as written (hex) to the stored object. Entries come from
-- the current requests; without a requests file, from what the lock recorded.
local function map_text(lock, requests)
  local rows = {}
  if requests then
    for _, r in ipairs(requests) do
      local entry = lock.sources[r.uri]
      if entry then rows[#rows + 1] = { lib.hex_encode(r.raw), entry.sha256 } end
    end
  else
    for _, entry in pairs(lock.sources) do
      rows[#rows + 1] = { lib.hex_encode(entry.source or ""), entry.sha256 }
    end
  end
  table.sort(rows, function(a, b) return a[1] < b[1] end)
  local out = {}
  for _, row in ipairs(rows) do
    out[#out + 1] = string.format("\\PdfAnnexProvideResolvedArtifact{%s}{%s}", row[1], object_path(row[2]))
  end
  return table.concat(out, "\n") .. "\n"
end

local function write_map(lock, requests)
  local text = map_text(lock, requests)
  if lib.read_file(MAP) == text then return end
  assert(lib.mkdirs(lib.dirname(MAP)))
  assert(lib.atomic_write(MAP, text))
end

---------------------------------------------------------------- resolvers
local describe_cache = {}

-- Built-in handler for pdfannex://file/<project-relative path>. Plain paths are
-- not routed through a resolver program. Only files inside the project root are
-- served, so a foreign .tex file cannot import arbitrary files into the store.
local function locate_file(source)
  local path, query = source:match("^pdfannex://file/([^?]*)%??(.*)$")
  path = path and lib.normalize_path(lib.pct_decode(path))
  if not path or path == "" then
    return nil, "invalid-source", "expected pdfannex://file/<path>"
  end
  if query ~= "" then
    return nil, "unsupported-source-option", "plain files take no options: " .. query
  end
  if lib.is_absolute(path) then
    return nil, "invalid-source", "absolute paths are not allowed"
  end
  local cur = ""
  for part in path:gmatch("[^/]+") do
    if part == ".." then
      return nil, "permission-denied", "paths must stay inside the project"
    end
    if part ~= "." then
      cur = cur == "" and part or (cur .. "/" .. part)
      -- Symlinks could point outside the project; they are refused outright.
      if lfs.symlinkattributes(cur, "mode") == "link" then
        return nil, "permission-denied", "symbolic links are not allowed: " .. cur
      end
    end
  end
  if lfs.attributes(cur, "mode") ~= "file" then
    return nil, "resource-not-found", "no such file: " .. cur
  end
  return cur
end

local function file_call(operation, items)
  local byid = {}
  for _, req in ipairs(items) do
    local rel, code, message = locate_file(req.source or "")
    if not rel then
      byid[req.id] = { id = req.id, error = { code = code, message = message } }
    elseif operation == "resolve" then
      byid[req.id] = { id = req.id, resolved = req.source,
                       artifact = { path = lib.normalize_path(lfs.currentdir()) .. "/" .. rel } }
    elseif not req.lockedSha256 then
      byid[req.id] = { id = req.id, state = "unknown" }
    else
      local data = lib.read_file(rel)
      byid[req.id] = data
        and { id = req.id, state = lib.sha256_hex(data) == req.lockedSha256 and "up-to-date" or "update-available" }
        or { id = req.id, error = { code = "permission-denied", message = "cannot read " .. rel } }
    end
  end
  return byid
end

local function find_resolver(scheme)
  local name = "pdfannex-resolver-" .. scheme
  local found = lib.find_resolver(name)
  if found then return found end
  return nil, "no resolver '" .. name .. "' found on PATH for scheme '" .. scheme .. "'"
end

-- Returns resolver info after checking Protocol 1 compatibility, once per run.
local function connect(scheme)
  if describe_cache[scheme] then return table.unpack(describe_cache[scheme]) end
  local exe, err = find_resolver(scheme)
  local result
  if not exe then
    result = { nil, err }
  else
    local resp, rerr = lib.run_resolver(exe, { operation = "describe" })
    if not resp then
      result = { nil, "resolver for '" .. scheme .. "': " .. rerr }
    else
      local compatible = false
      for _, v in ipairs(resp.protocolVersions or {}) do if v == 1 then compatible = true end end
      local handles = false
      for _, s in ipairs(resp.schemes or {}) do if s == scheme then handles = true end end
      if not compatible then
        result = { nil, "resolver for '" .. scheme .. "' does not support Resolver Protocol 1" }
      elseif not handles then
        result = { nil, "resolver for '" .. scheme .. "' does not declare that scheme" }
      else
        local caps = {}
        for _, c in ipairs(resp.capabilities or {}) do caps[c] = true end
        result = { { exe = exe, capabilities = caps } }
      end
    end
  end
  describe_cache[scheme] = result
  return table.unpack(result)
end

-- items: list of { id, source, ... }; returns map id -> result or nil, err.
local function call(scheme, operation, items)
  if scheme == "file" then return file_call(operation, items) end
  local info, err = connect(scheme)
  if not info then return nil, err end
  if operation == "status" and not info.capabilities.status then return {} end
  local resp, rerr = lib.run_resolver(info.exe,
    { protocolVersion = 1, operation = operation, requests = items })
  if not resp then return nil, rerr end
  if resp.error then
    return nil, "resolver for '" .. scheme .. "': " .. tostring(resp.error.code)
                .. ": " .. tostring(resp.error.message)
  end
  local byid = {}
  for _, r in ipairs(resp.results or {}) do byid[r.id] = r end
  return byid
end

local function group_by_scheme(items)
  local groups, order = {}, {}
  for _, item in ipairs(items) do
    local scheme = lib.source_scheme(item.source) or "?"
    if not groups[scheme] then groups[scheme] = {}; order[#order + 1] = scheme end
    table.insert(groups[scheme], item)
  end
  return groups, order
end

---------------------------------------------------------------- commands
local function store_object(data, sha)
  local path = object_path(sha)
  if lib.exists(path) then return end
  assert(lib.mkdirs(lib.dirname(path)))
  assert(lib.atomic_write(path, data))
end

local function prepare(jobname, update)
  local requests = load_requests(jobname)
  if not requests then
    print("pdfannex: no " .. jobname .. ".pdfannex-requests yet; run LaTeX once first")
    return 0
  end
  local old = load_lock()
  local new = { schema = 1, sources = {} }
  local todo, errors = {}, {}

  local raws = {}
  for _, r in ipairs(requests) do
    local src = r.uri
    raws[src] = raws[src] or r.raw
    local entry = old.sources[src]
    if entry and not update then
      if lib.exists(object_path(entry.sha256)) then
        entry.source = entry.source or raws[src]
        new.sources[src] = entry
      else
        -- Exact recovery: ask for the locked resolved locator, never the latest.
        todo[#todo + 1] = { id = src, source = entry.resolved or src, locked = entry }
      end
    else
      todo[#todo + 1] = { id = src, source = src }
    end
  end

  local groups, order = group_by_scheme(todo)
  for _, scheme in ipairs(order) do
    local items = {}
    for i, item in ipairs(groups[scheme]) do items[i] = { id = item.id, source = item.source } end
    local results, err = call(scheme, "resolve", items)
    if not results then
      errors[#errors + 1] = err
    else
      for _, item in ipairs(groups[scheme]) do
        local res = results[item.id]
        if not res then
          errors[#errors + 1] = item.id .. ": resolver returned no result"
        elseif res.error then
          errors[#errors + 1] = item.id .. ": " .. tostring(res.error.code) .. ": " .. tostring(res.error.message)
        elseif type(res.artifact) ~= "table" or type(res.artifact.path) ~= "string" then
          errors[#errors + 1] = item.id .. ": resolver returned no artifact path"
        else
          local data = lib.read_file(res.artifact.path)
          if not data then
            errors[#errors + 1] = item.id .. ": cannot read artifact " .. res.artifact.path
          elseif not lib.looks_like_pdf(data) then
            errors[#errors + 1] = item.id .. ": artifact is not a PDF"
          else
            local sha = lib.sha256_hex(data)
            if item.locked and item.locked.sha256 ~= sha then
              errors[#errors + 1] = item.id .. ": hash mismatch, locked " .. item.locked.sha256
                .. " but the source now yields " .. sha .. "; run 'pdfannex update' to accept"
            else
              store_object(data, sha)
              new.sources[item.id] = {
                resolver = scheme,
                source = raws[item.id],
                requested = item.id,
                resolved = res.resolved or item.source,
                sha256 = sha,
                mediaType = "application/pdf",
              }
            end
          end
        end
      end
    end
  end

  -- Transactional: a failure leaves the old lock and map untouched.
  if #errors > 0 then
    for _, e in ipairs(errors) do io.stderr:write("pdfannex: ", e, "\n") end
    return 1
  end
  local text = lib.json_encode(new, true) .. "\n"
  if lib.read_file(LOCK) ~= text then assert(lib.atomic_write(LOCK, text)) end
  write_map(new, requests)
  local changed = #todo
  print(string.format("pdfannex: %d source(s) locked, %d resolved", #requests, changed))
  return 0
end

local function verify(jobname)
  local lock = load_lock()
  local problems = {}
  local function problem(msg) problems[#problems + 1] = msg end
  for src, entry in pairs(lock.sources) do
    local path = object_path(entry.sha256 or "")
    local data = lib.read_file(path)
    if not data then
      problem(src .. ": artifact missing (" .. path .. ")")
    elseif lib.sha256_hex(data) ~= entry.sha256 then
      problem(src .. ": artifact hash does not match the lock")
    elseif not lib.looks_like_pdf(data) then
      problem(src .. ": artifact is not a plausible PDF")
    end
  end
  if lib.read_file(MAP) ~= map_text(lock, load_requests(jobname)) then
    problem(MAP .. " is missing or out of date; run 'pdfannex prepare'")
  end
  local requests = load_requests(jobname)
  for _, r in ipairs(requests or {}) do
    if not lock.sources[r.uri] then problem(r.uri .. ": requested but not locked") end
  end
  if #problems > 0 then
    table.sort(problems)
    for _, p in ipairs(problems) do io.stderr:write("pdfannex: ", p, "\n") end
    return 1
  end
  print("pdfannex: verify ok")
  return 0
end

local function status(jobname)
  local requests = load_requests(jobname)
  if not requests then die("no " .. jobname .. ".pdfannex-requests; run LaTeX first") end
  local lock = load_lock()
  local states, items = {}, {}
  local listed = {}
  for _, r in ipairs(requests) do
    local src = r.uri
    listed[#listed + 1] = src
    local entry = lock.sources[src]
    if entry then
      items[#items + 1] = { id = src, source = src, resolved = entry.resolved,
                            lockedSha256 = entry.sha256 }
    else
      states[src] = "unlocked"
    end
  end
  local groups, order = group_by_scheme(items)
  for _, scheme in ipairs(order) do
    local results, err = call(scheme, "status", groups[scheme])
    for _, item in ipairs(groups[scheme]) do
      local res = results and results[item.id]
      if not results then
        states[item.id] = "error: " .. err
      elseif not res then
        states[item.id] = "unknown"
      elseif res.error then
        states[item.id] = "error: " .. tostring(res.error.code)
      else
        states[item.id] = res.state or "unknown"
      end
    end
  end
  local bad = false
  for _, src in ipairs(listed) do
    print(string.format("%-16s %s", states[src], src))
    if states[src]:find("^error") then bad = true end
  end
  return bad and 1 or 0
end

---------------------------------------------------------------- main
local cmd, doc = arg[1], arg[2]
if cmd == "--version" then print("pdfannex " .. VERSION); os.exit(0) end
if not cmd or cmd == "--help" or cmd == "-h" then print(USAGE); os.exit(cmd and 0 or 1) end
if cmd == "init" then
  if lib.read_file(LOCK) then print("pdfannex: " .. LOCK .. " already exists"); os.exit(0) end
  assert(lib.atomic_write(LOCK, lib.json_encode({ schema = 1, sources = {} }, true) .. "\n"))
  print("pdfannex: created " .. LOCK .. "; run LaTeX, then 'pdfannex prepare'")
  os.exit(0)
end
if not doc then io.stderr:write(USAGE, "\n"); os.exit(1) end
if not ({ prepare = 1, update = 1, status = 1, verify = 1 })[cmd] then
  die("unknown command '" .. cmd .. "'")
end

doc = lib.normalize_path(doc)
local dir, base = doc:match("^(.*)/([^/]*)$")
if not dir then dir, base = ".", doc end
local jobname = base:gsub("%.tex$", "")
local workdir = dir == "" and "/" or dir
if workdir:match("^%a:$") then workdir = workdir .. "/" end
assert(lfs.chdir(workdir))

local rc
if cmd == "prepare" then rc = prepare(jobname, false)
elseif cmd == "update" then rc = prepare(jobname, true)
elseif cmd == "status" then rc = status(jobname)
else rc = verify(jobname) end
os.exit(rc)
