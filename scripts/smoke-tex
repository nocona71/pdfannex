#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

workdir="$(mktemp -d)"
trap 'rm -rf "$workdir"' EXIT
cp testfiles/load-package.tex "$workdir/"

for engine in pdflatex lualatex xelatex; do
  echo "==> $engine"
  TEXINPUTS="$PWD/tex:${TEXINPUTS:-}" \
    "$engine" -interaction=nonstopmode -halt-on-error \
    -output-directory="$workdir" "$workdir/load-package.tex" >/dev/null
  test -s "$workdir/load-package.pdf"
  rm -f "$workdir"/load-package.{aux,log,pdf,out}
done
