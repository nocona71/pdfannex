#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

for script in scripts/*; do
  [[ -f "$script" ]] || continue
  IFS= read -r shebang <"$script"
  [[ "$shebang" == '#!/usr/bin/env bash' ]] && bash -n "$script"
done

python3 testfiles/test_devcontainer.py
python3 testfiles/test_packaging.py
python3 testfiles/test_geometry.py
python3 testfiles/test_pagination.py
python3 testfiles/test_nup.py
# Root CI runs this same target through the adapter's composite action.
if [[ "${PDFANNEX_SKIP_ADAPTER_TESTS:-0}" != 1 ]]; then
  make -C adapter-example test
fi
python3 testfiles/test_cli.py
python3 testfiles/test_dod.py

# Same suites with sources locked through the CLI and original PDFs deleted.
for t in geometry pagination nup dod; do
  PDFANNEX_TEST_LOCKED=1 python3 "testfiles/test_$t.py"
done
./scripts/smoke-tex
shellcheck scripts/e2e-ctan
