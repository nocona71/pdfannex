#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

for script in scripts/*; do
  [[ -f "$script" ]] || continue
  IFS= read -r shebang <"$script"
  [[ "$shebang" == '#!/usr/bin/env bash' ]] && bash -n "$script"
done

python3 testfiles/test_devcontainer.py
python3 testfiles/test_packaging.py
python3 testfiles/test_geometry.py
./scripts/smoke-tex
